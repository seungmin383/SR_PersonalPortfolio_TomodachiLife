{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Schema",
  "type": "object",
  "properties": {
    "UI Data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "PlaceID": { "type": "integer" },
          "PrototypeTag": { "type": "string" },
          "ViewportType": { "type": "integer" }
