              <instance_material symbol="mtBodyShadow_mat" target="#mtBodyShadow_mat-material">
                <bind_vertex_input semantic="CHANNEL1" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
