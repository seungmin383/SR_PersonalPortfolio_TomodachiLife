      <node id="node-bodyShadow" name="bodyShadow" sid="joint0" type="JOINT">
        <rotate>-1 0 0 -90.00001</rotate>
        <scale>0.3937008 0.3937008 0.3937008</scale>
        <extra>
          <technique profile="OpenCOLLADA">
            <cast_shadows sid="cast_shadows" type="bool">1</cast_shadows>
